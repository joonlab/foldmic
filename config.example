# ~/.config/foldmic/config 로 복사해서 채운다 (셸 형식 — bin/foldmic 이 source 한다).
# 같은 이름의 환경변수가 있으면 그쪽이 먼저다.

# 폰의 adb 주소 — 폰 Tailscale IP(또는 같은 와이파이의 IP) + 무선 디버깅 포트
FOLDMIC_PHONE="<phone-tailscale-ip>:5555"

# 끌 때 돌아갈 입력 장치. 비우면 BlackHole 이 아닌 첫 입력 장치(보통 내장 마이크)
FOLDMIC_FALLBACK=""

# 폰 소리를 흘릴 가상 입력 장치
FOLDMIC_VDEV="BlackHole 2ch"
